/-- The escape after a backslash: the byte it stands for, or 0. -/
def esc : List UInt8 := (List.range 256).map fun b =>
  match Char.ofNat b with
  | '"' => 0x22 | '\\' => 0x5C | '/' => 0x2F | 'b' => 8 | 'f' => 12 | 'n' => 10 | 'r' => 13 | 't' => 9
  | _ => 0

/-- A byte's hex digit value, or 0x80. -/
def hexv : List UInt8 := (List.range 256).map fun b =>
  if 48 ≤ b ∧ b < 58 then UInt8.ofNat (b - 48)
  else if 97 ≤ b ∧ b < 103 then UInt8.ofNat (b - 87)
  else if 65 ≤ b ∧ b < 71 then UInt8.ofNat (b - 55) else 0x80

/-- Row `k` moves a vector's first `k` bytes to its end, the rest zero. -/
def shuf : List UInt8 := (List.range 17).flatMap fun k =>
  (List.range 16).map fun j => if j + k ≥ 16 then UInt8.ofNat (j + k - 16) else 0x80

def u16le (x : Nat) : List UInt8 := [UInt8.ofNat (x % 256), UInt8.ofNat (x / 256)]
def u64le (x : Nat) : List UInt8 := (List.range 8).map fun i => UInt8.ofNat (x / 256 ^ i % 256)

/-- The bytes the code reads. -/
def data : Body := [
   p2align 5,
  lbl "V_QUOTE", bytes (List.replicate 32 0x22),
  lbl "V_BSLASH", bytes (List.replicate 32 0x5C),
  lbl "V_80", bytes (List.replicate 32 0x80),
  lbl "V_A0", bytes (List.replicate 32 0xA0),
  lbl "V_SPACE", bytes (List.replicate 32 0x20),
  lbl "V_NL", bytes (List.replicate 32 0x0A),
  lbl "V16_M48", bytes (List.replicate 16 0xD0),
  lbl "V16_9", bytes (List.replicate 16 9),
  lbl "W10", bytes ((List.range 8).flatMap fun _ => [10, 1]),
  lbl "W100", bytes ((List.range 4).flatMap fun _ => u16le 100 ++ u16le 1),
  lbl "W1E4", bytes ((List.range 4).flatMap fun _ => u16le 10000 ++ u16le 1),
  lbl "SHUF", bytes shuf,
  lbl "P10U", bytes ((List.range 20).flatMap fun i => u64le (10 ^ i)),
  lbl "ESC", bytes esc,
  lbl "HEXV", bytes hexv]

/-- The code and its data. -/
def code (L : Layout) : Body := parse L ++ data

end JsonAsm
