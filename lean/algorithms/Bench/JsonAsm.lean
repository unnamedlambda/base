module
public import AlgorithmLib.Vocab.X86
meta import AlgorithmLib.Vocab.X86
import all Init.Data.Repr
import all Init.Data.List.Sort.Basic
@[expose] public section

/-! The machine code `Json` carries for its parse loop's fast paths: strings,
    numbers, literals and structure, written here and assembled by base's
    assembler (`X86.assemble`). `Json.parseBody` runs it where the machine has
    AVX2, BMI1 and LZCNT, and runs every trip it hands back itself. -/

namespace JsonAsm

open AlgorithmLib.X86

/-- Where the parse keeps what the code reads and writes: offsets in the
    arena (`Json`'s), and the bounds it checks. -/
structure Layout where
  sb : Nat
  pow10 : Nat
  powi : Nat
  pow5 : Nat
  stack : Nat
  tape : Nat
  strs : Nat
  strBytes : Nat
  tapeWords : Nat
  maxDepth : Nat

/-- `rbx` past JSON's whitespace, at most `e` (`r12`): unmoved where the
    byte there is past a space; one on past a lone space; else 32 bytes at a
    time up to the first not a space or a newline, then a byte at a time.
    Scratch: rax, rcx, ymm0–ymm2. -/
def skipWs (p : String) : Body :=
  [
   cmp rbx r12,
   jae (p ++ "m5"),
   movzx eax (byte rbx),
   cmp eax 0x20,
   ja (p ++ "m5"),
   jne (p ++ "m0"),
   lea rcx (mem (rbx + 1)),
   cmp rcx r12,
   jae (p ++ "m0"),
   movzx eax (byte rcx),
   cmp eax 0x20,
   jbe (p ++ "m0"),
   mov rbx rcx,
   jmp (p ++ "m5"),
   lbl (p ++ "m0"), cmp rbx r12,
   jae (p ++ "m5"),
   lea rcx (mem (rbx + 0x20)),
   cmp rcx r12,
   ja (p ++ "m2"),
   vmovdqu ymm0 (ymmword rbx),
   vpcmpeqb ymm1 ymm0 ymm11,
   vpcmpeqb ymm2 ymm0 ymm10,
   vpor ymm1 ymm1 ymm2,
   vpmovmskb eax ymm1,
   xor eax (-1),
   jne (p ++ "m1"),
   add rbx 0x20,
   jmp (p ++ "m0"),
   lbl (p ++ "m1"), tzcnt eax eax,
   add rbx rax,
   movzx eax (byte rbx),
   cmp eax 0x20,
   ja (p ++ "m5"),
   jmp (p ++ "m3"),
   lbl (p ++ "m2"), movzx eax (byte rbx),
   lbl (p ++ "m3"), cmp eax 0x20,
   je (p ++ "m4"),
   cmp eax 0xa,
   je (p ++ "m4"),
   cmp eax 0xd,
   je (p ++ "m4"),
   cmp eax 9,
   jne (p ++ "m5"),
   lbl (p ++ "m4"), inc rbx,
   jmp (p ++ "m0"),
   lbl (p ++ "m5")]

/-- Four hex digits at `rdx + off` into eax; to `handoff` where one is not
    (`HEXV` gives 0x80 for a byte not a hex digit). Scratch: r8, r9. -/
def hex4 (off : Nat) : Body :=
  [
   lea r8 (mem (rip "HEXV")),
   movzx eax (byte (rdx + off)),
   movzx eax (byte (r8 + rax*1)),
   test eax 0x80,
   jne "handoff",
   movzx r9d (byte (rdx + off + 1)),
   movzx r9d (byte (r8 + r9*1)),
   test r9d 0x80,
   jne "handoff",
   shl eax 4,
   or eax r9d,
   movzx r9d (byte (rdx + off + 2)),
   movzx r9d (byte (r8 + r9*1)),
   test r9d 0x80,
   jne "handoff",
   shl eax 4,
   or eax r9d,
   movzx r9d (byte (rdx + off + 3)),
   movzx r9d (byte (r8 + r9*1)),
   test r9d 0x80,
   jne "handoff",
   shl eax 4,
   or eax r9d]

/-- **A string**, `rdx` just past its opening quote: its unescaped bytes at
    string offset `sp + 4` (`r14`), its length (`u32`) at `sp`, its tape word
    `"` | sp at tape index `tp` (`r13`); then `rbx` past its close and `r14`
    past its bytes. 32 bytes at a time up to a quote, a backslash or a
    control byte (copied whole: the buffer has room past its end); the
    escapes `\" \\ \/ \b \f \n \r \t` (`ESC`) and `\uXXXX`, a high surrogate
    with the low one after it, as UTF-8. To `handoff` where it is not a JSON
    string. Scratch: rax, rcx, rdx, r8–r11, ymm0–ymm3. -/
def string (L : Layout) (p : String) : Body :=
  [
   lea rcx (mem ((r15 + r14*1 : Addr) + L.strs + 4)),
   mov r10 rcx,
   lbl (p ++ "m0"), lea rax (mem (rdx + 0x20)),
   cmp rax r12,
   ja (p ++ "m2"),
   vmovdqu ymm0 (ymmword rdx),
   vmovdqu (ymmword rcx) ymm0,
   vpcmpeqb ymm1 ymm0 ymm15,
   vpcmpeqb ymm2 ymm0 ymm14,
   vpxor ymm3 ymm0 ymm13,
   vpcmpgtb ymm3 ymm12 ymm3,
   vpmovmskb r11d ymm1,
   vpor ymm2 ymm2 ymm3,
   vpmovmskb eax ymm2,
   or eax r11d,
   jne (p ++ "m1"),
   add rdx 0x20,
   add rcx 0x20,
   jmp (p ++ "m0"),
   lbl (p ++ "m1"), tzcnt eax eax,
   tzcnt r11d r11d,
   add rdx rax,
   add rcx rax,
   cmp eax r11d,
   je (p ++ "m10"),
   movzx eax (byte rdx),
   jmp (p ++ "m3"),
   lbl (p ++ "m2"), cmp rdx r12,
   jae "handoff",
   movzx eax (byte rdx),
   lbl (p ++ "m3"), cmp eax 0x22,
   je (p ++ "m10"),
   cmp eax 0x20,
   jb "handoff",
   cmp eax 0x5c,
   je (p ++ "m4"),
   mov (byte rcx) al,
   inc rdx,
   inc rcx,
   jmp (p ++ "m0"),
   lbl (p ++ "m4"), lea rax (mem (rdx + 1)),
   cmp rax r12,
   jae "handoff",
   movzx eax (byte (rdx + 1)),
   lea r11 (mem (rip "ESC")),
   movzx r11d (byte (r11 + rax*1)),
   test r11d r11d,
   je (p ++ "m5"),
   mov (byte rcx) r11b,
   add rdx 2,
   inc rcx,
   jmp (p ++ "m0"),
   lbl (p ++ "m5"), cmp eax 0x75,
   jne "handoff",
   lea rax (mem (rdx + 6)),
   cmp rax r12,
   ja "handoff"] ++
  hex4 2 ++
  [
   mov r11d eax,
   and r11d 0xfc00,
   cmp r11d 0xdc00,
   je "handoff",
   cmp r11d 0xd800,
   jne (p ++ "m6"),
   lea r11 (mem (rdx + 0xc)),
   cmp r11 r12,
   ja "handoff",
   cmp (byte (rdx + 6)) 0x5c,
   jne "handoff",
   cmp (byte (rdx + 7)) 0x75,
   jne "handoff",
   mov r11d eax] ++
  hex4 8 ++
  [
   mov r9d eax,
   and r9d 0xfc00,
   cmp r9d 0xdc00,
   jne "handoff",
   and eax 0x3ff,
   and r11d 0x3ff,
   shl r11d 0xa,
   or eax r11d,
   add eax 0x10000,
   add rdx 6,
   lbl (p ++ "m6"), add rdx 6,
   cmp eax 0x80,
   jae (p ++ "m7"),
   mov (byte rcx) al,
   inc rcx,
   jmp (p ++ "m0"),
   lbl (p ++ "m7"), cmp eax 0x800,
   jae (p ++ "m8"),
   mov r11d eax,
   shr r11d 6,
   or r11d 0xc0,
   mov (byte rcx) r11b,
   and eax 0x3f,
   or eax 0x80,
   mov (byte (rcx + 1)) al,
   add rcx 2,
   jmp (p ++ "m0"),
   lbl (p ++ "m8"), cmp eax 0x10000,
   jae (p ++ "m9"),
   mov r11d eax,
   shr r11d 0xc,
   or r11d 0xe0,
   mov (byte rcx) r11b,
   mov r11d eax,
   shr r11d 6,
   and r11d 0x3f,
   or r11d 0x80,
   mov (byte (rcx + 1)) r11b,
   and eax 0x3f,
   or eax 0x80,
   mov (byte (rcx + 2)) al,
   add rcx 3,
   jmp (p ++ "m0"),
   lbl (p ++ "m9"), mov r11d eax,
   shr r11d 0x12,
   or r11d 0xf0,
   mov (byte rcx) r11b,
   mov r11d eax,
   shr r11d 0xc,
   and r11d 0x3f,
   or r11d 0x80,
   mov (byte (rcx + 1)) r11b,
   mov r11d eax,
   shr r11d 6,
   and r11d 0x3f,
   or r11d 0x80,
   mov (byte (rcx + 2)) r11b,
   and eax 0x3f,
   or eax 0x80,
   mov (byte (rcx + 3)) al,
   add rcx 4,
   jmp (p ++ "m0"),
   lbl (p ++ "m10"), lea rbx (mem (rdx + 1)),
   mov rax rcx,
   sub rax r10,
   mov (dword ((r15 + r14*1 : Addr) + L.strs)) eax,
   movabs rax 0x2200000000000000,
   or rax r14,
   mov (qword ((r15 + r13*8 : Addr) + L.tape)) rax,
   inc r13,
   lea r14 (mem (rcx - L.strs)),
   sub r14 r15]

/-- The digits leading the 16 bytes at `ptr` (0 to 16) into rdi, their value
    into rax: the bytes less `'0'`, the digits' mask, then the digits moved to
    the vector's end (`SHUF`) and summed in pairs, fours and eights. Scratch:
    rdx, r11, xmm0–xmm2. -/
def digRun (ptr : Reg) : Body :=
  [
   vmovdqu xmm0 (xmmword ptr),
   vpaddb xmm0 xmm0 (xmmword (rip "V16_M48")),
   vpcmpgtb xmm1 xmm0 (xmmword (rip "V16_9")),
   vpxor xmm2 xmm2 xmm2,
   vpcmpgtb xmm2 xmm2 xmm0,
   vpor xmm1 xmm1 xmm2,
   vpmovmskb eax xmm1,
   or eax 0x10000,
   tzcnt edi eax,
   mov r11d edi,
   shl r11d 4,
   lea rdx (mem (rip "SHUF")),
   vpshufb xmm0 xmm0 (xmmword (rdx + r11*1)),
   vpmaddubsw xmm0 xmm0 (xmmword (rip "W10")),
   vpmaddwd xmm0 xmm0 (xmmword (rip "W100")),
   vpackssdw xmm0 xmm0 xmm0,
   vpmaddwd xmm0 xmm0 (xmmword (rip "W1E4")),
   vmovq rax xmm0,
   mov edx eax,
   shr rax 0x20,
   imul3 rdx rdx 0x5f5e100,
   add rax rdx]

/-- **Eisel–Lemire** for `w · 10^q` (`w` in r8, not 0; `q` in rdi, in
    `-342 … 308`): the double's bits without the sign into rax, as
    `Json.eiselLemire` computes them; to `handoff` where that cannot round.
    Scratch: rcx, rdx, rsi, r9–r11. -/
def eiselLemire (L : Layout) (p : String) : Body :=
  [
   lzcnt rcx r8,
   mov rsi r8,
   shl rsi cl,
   mov r10 rcx,
   lea r11 (mem (rdi + 0x156)),
   shl r11 4,
   add r11 r15,
   mov rax (qword (r11 + L.pow5)),
   mul rsi,
   mov ecx edx,
   and ecx 0x1ff,
   cmp ecx 0x1ff,
   jne (p ++ "m0"),
   mov r9 rdx,
   mov rcx rax,
   mov rax (qword (r11 + L.pow5 + 8)),
   mul rsi,
   add rcx rdx,
   adc r9 0,
   mov rax rcx,
   mov rdx r9,
   lbl (p ++ "m0"), mov rsi rdx,
   shr rsi 0x3f,
   lea ecx (mem (rsi + 9)),
   mov r11 rdx,
   shr r11 cl,
   imul3 rcx rdi 0x3526a,
   sar rcx 0x10,
   add rcx 0x43e,
   add rcx rsi,
   sub rcx r10,
   test rcx rcx,
   jle "handoff",
   cmp rax (-1),
   jne (p ++ "m1"),
   cmp rdi (-27),
   jl "handoff",
   cmp rdi 0x37,
   jg "handoff",
   lbl (p ++ "m1"), cmp rax 1,
   ja (p ++ "m2"),
   cmp rdi (-4),
   jl (p ++ "m2"),
   cmp rdi 0x17,
   jg (p ++ "m2"),
   mov r9d r11d,
   and r9d 3,
   cmp r9d 1,
   jne (p ++ "m2"),
   mov r9 rcx,
   lea ecx (mem (rsi + 9)),
   mov r10 r11,
   shl r10 cl,
   mov rcx r9,
   cmp r10 rdx,
   jne (p ++ "m2"),
   and r11 (-2),
   lbl (p ++ "m2"), mov rax r11,
   and eax 1,
   add r11 rax,
   shr r11 1,
   mov rax r11,
   shr rax 0x35,
   je (p ++ "m3"),
   mov r11 1,
   shl r11 0x34,
   inc rcx,
   lbl (p ++ "m3"), cmp rcx 0x7ff,
   jge (p ++ "m4"),
   mov rax 1,
   shl rax 0x34,
   dec rax,
   and r11 rax,
   shl rcx 0x34,
   or r11 rcx,
   mov rax r11,
   jmp (p ++ "m5"),
   lbl (p ++ "m4"), movabs rax 0x7ff0000000000000,
   lbl (p ++ "m5")]

/-- **The parse loop's fast paths**, `parse(arena)` in rax, System V, no
    calls, the callee-saved registers it uses saved. The state block at
    `arena + L.sb`: the text's position and end, the tape's length in words,
    the string bytes, the depth; then the trip's start. It runs trips as
    `Json.parseBody` does (a value; then its closes, a comma and, in an object,
    the next key and its colon), every tape word, stack word and string byte
    the same, until the end (rax 0, the state final) or a trip it hands back
    (rax 1, the state that trip's start, which `Json.parseBody` then runs): a
    number past 19 digits or one Eisel–Lemire cannot round, one within 40
    bytes of the end, and anything that is not JSON. Registers: r15 the arena,
    rbx the position, r12 the end, r13 tape words, r14 string bytes, rbp the
    depth; ymm10–ymm15 the bytes it compares against. -/
def parse (L : Layout) : Body :=
  let p := ""
  [
   lbl "jfast",
   push rbx,
   push rbp,
   push r12,
   push r13,
   push r14,
   push r15,
   mov r15 rdi,
   mov rbx (qword (r15 + L.sb)),
   mov r12 (qword (r15 + L.sb + 8)),
   mov r13 (qword (r15 + L.sb + 0x10)),
   mov r14 (qword (r15 + L.sb + 0x18)),
   mov rbp (qword (r15 + L.sb + 0x20)),
   vmovdqu ymm15 (ymmword (rip "V_QUOTE")),
   vmovdqu ymm14 (ymmword (rip "V_BSLASH")),
   vmovdqu ymm13 (ymmword (rip "V_80")),
   vmovdqu ymm12 (ymmword (rip "V_A0")),
   vmovdqu ymm11 (ymmword (rip "V_SPACE")),
   vmovdqu ymm10 (ymmword (rip "V_NL")),
   mov rax r12,
   sub rax rbx,
   lea rcx (mem ((r14 + rax*2 : Addr) + 0x28)),
   cmp rcx (.i L.strBytes),
   ja "handoff_now",
   lea rcx (mem ((r13 + rax*2 : Addr) + 8)),
   cmp rcx (.i (L.tapeWords - 2)),
   ja "handoff_now",
   lbl "trip",
   mov (qword (r15 + L.sb + 0x28)) rbx,
   mov (qword (r15 + L.sb + 0x30)) r13,
   mov (qword (r15 + L.sb + 0x38)) r14,
   mov (qword (r15 + L.sb + 0x40)) rbp] ++
  skipWs (p ++ "w1") ++
  [
   cmp rbx r12,
   jae "handoff",
   movzx eax (byte rbx),
   cmp eax 0x22,
   jne "v_notstr",
   lea rdx (mem (rbx + 1))] ++
  string L (p ++ "s1") ++
  [
   jmp "after",
   lbl "v_notstr",
   lea ecx (mem (rax - 0x30)),
   cmp ecx 9,
   jbe "number",
   cmp eax 0x2d,
   je "number",
   cmp eax 0x7b,
   je "v_open",
   cmp eax 0x5b,
   je "v_open",
   cmp eax 0x74,
   je "v_true",
   cmp eax 0x66,
   je "v_false",
   cmp eax 0x6e,
   je "v_null",
   jmp "handoff",
   lbl "v_true",
   lea rcx (mem (rbx + 4)),
   cmp rcx r12,
   ja "handoff",
   cmp (dword rbx) 0x65757274,
   jne "handoff",
   movabs rax 0x7400000000000000,
   jmp "v_lit",
   lbl "v_null",
   lea rcx (mem (rbx + 4)),
   cmp rcx r12,
   ja "handoff",
   cmp (dword rbx) 0x6c6c756e,
   jne "handoff",
   movabs rax 0x6e00000000000000,
   jmp "v_lit",
   lbl "v_false",
   lea rcx (mem (rbx + 5)),
   cmp rcx r12,
   ja "handoff",
   cmp (dword (rbx + 1)) 0x65736c61,
   jne "handoff",
   movabs rax 0x6600000000000000,
   lbl "v_lit",
   mov (qword ((r15 + r13*8 : Addr) + L.tape)) rax,
   inc r13,
   mov rbx rcx,
   jmp "after",
   lbl "v_open",
   cmp rbp (.i L.maxDepth),
   jae "handoff",
   xor r8d r8d,
   cmp eax 0x7b,
   jne (p ++ "m0"),
   inc r8d,
   lbl (p ++ "m0"), inc rbx] ++
  skipWs (p ++ "w2") ++
  [
   cmp rbx r12,
   jae "v_push",
   movzx eax (byte rbx),
   mov ecx r8d,
   shl ecx 5,
   add ecx 0x5d,
   cmp eax ecx,
   je "v_empty",
   lbl "v_push",
   lea rax (mem (r8 + r13*2)),
   mov (qword ((r15 + rbp*8 : Addr) + L.stack)) rax,
   inc r13,
   inc rbp,
   test r8d r8d,
   jne "key",
   jmp "trip",
   lbl "v_empty",
   lea rax (mem (r13 + 1)),
   mov rcx r8,
   shl rcx 0x3d,
   movabs rdx 0x5b00000000000000,
   add rcx rdx,
   or rcx rax,
   mov (qword ((r15 + r13*8 : Addr) + L.tape)) rcx,
   mov rcx r8,
   shl rcx 0x3d,
   movabs rdx 0x5d00000000000000,
   add rcx rdx,
   or rcx r13,
   mov (qword ((r15 + r13*8 : Addr) + L.tape + 8)) rcx,
   add r13 2,
   inc rbx,
   jmp "after",
   lbl "key"] ++
  skipWs (p ++ "w3") ++
  [
   cmp rbx r12,
   jae "handoff",
   cmp (byte rbx) 0x22,
   jne "handoff",
   lea rdx (mem (rbx + 1))] ++
  string L (p ++ "s2") ++
  skipWs (p ++ "w4") ++
  [
   cmp rbx r12,
   jae "handoff",
   cmp (byte rbx) 0x3a,
   jne "handoff",
   inc rbx,
   jmp "trip",
   lbl "after"] ++
  skipWs (p ++ "w5") ++
  [
   cmp rbx r12,
   jae "a_end",
   test rbp rbp,
   je "handoff",
   mov rax (qword ((r15 + rbp*8 : Addr) + L.stack - 8)),
   movzx ecx (byte rbx),
   cmp ecx 0x2c,
   jne "a_close",
   inc rbx,
   test eax 1,
   jne "key",
   jmp "trip",
   lbl "a_close",
   mov edx eax,
   and edx 1,
   shl edx 5,
   add edx 0x5d,
   cmp ecx edx,
   jne "handoff",
   mov rdx rax,
   shr rdx 1,
   mov rcx rax,
   and ecx 1,
   shl rcx 0x3d,
   movabs r8 0x5b00000000000000,
   add r8 rcx,
   or r8 r13,
   mov (qword ((r15 + rdx*8 : Addr) + L.tape)) r8,
   movabs r8 0x5d00000000000000,
   add r8 rcx,
   or r8 rdx,
   mov (qword ((r15 + r13*8 : Addr) + L.tape)) r8,
   inc r13,
   inc rbx,
   dec rbp,
   jmp "after",
   lbl "a_end",
   test rbp rbp,
   jne "handoff",
   mov (qword (r15 + L.sb)) rbx,
   mov (qword (r15 + L.sb + 0x10)) r13,
   mov (qword (r15 + L.sb + 0x18)) r14,
   mov (qword (r15 + L.sb + 0x20)) rbp,
   xor eax eax,
   jmp "out",
   lbl "handoff_now",
   mov eax 1,
   jmp "out",
   lbl "handoff",
   mov rax (qword (r15 + L.sb + 0x28)),
   mov (qword (r15 + L.sb)) rax,
   mov rax (qword (r15 + L.sb + 0x30)),
   mov (qword (r15 + L.sb + 0x10)) rax,
   mov rax (qword (r15 + L.sb + 0x38)),
   mov (qword (r15 + L.sb + 0x18)) rax,
   mov rax (qword (r15 + L.sb + 0x40)),
   mov (qword (r15 + L.sb + 0x20)) rax,
   mov eax 1,
   lbl "out",
   vzeroupper,
   pop r15,
   pop r14,
   pop r13,
   pop r12,
   pop rbp,
   pop rbx,
   ret,
   lbl "number",
   lea rcx (mem (rbx + 0x28)),
   cmp rcx r12,
   ja "handoff",
   xor r10d r10d,
   cmp eax 0x2d,
   jne (p ++ "m1"),
   inc r10d,
   lbl (p ++ "m1"), lea r9 (mem (rbx + r10*1))] ++
  digRun r9 ++
  [
   test edi edi,
   je "handoff",
   mov r8 rax,
   mov ecx edi,
   add r9 rdi,
   cmp edi 0x10,
   jne (p ++ "m2")] ++
  digRun r9 ++
  [
   cmp edi 3,
   ja "handoff",
   lea rdx (mem (rip "P10U")),
   imul r8 (qword (rdx + rdi*8)),
   add r8 rax,
   add ecx edi,
   add r9 rdi,
   lbl (p ++ "m2"), cmp ecx 1,
   jbe (p ++ "m3"),
   cmp (byte (rbx + r10*1)) 0x30,
   je "handoff",
   lbl (p ++ "m3"), mov (qword (r15 + L.sb + 0x50)) rcx,
   xor edi edi,
   movzx eax (byte r9),
   cmp eax 0x2e,
   jne (p ++ "m5"),
   inc r9] ++
  digRun r9 ++
  [
